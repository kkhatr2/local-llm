{
  "$schema": "https://opencode.ai/config.json",
  // Default to a free OpenCode Console model. Change this ID to any of the
  // free model IDs listed below to switch the default.
  "model": "opencode/big-pickle",

  // Project instructions loaded by OpenCode.
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
  ],

  // Free chat models currently listed in the OpenCode Console catalog:
  //   opencode/big-pickle
  //   opencode/tidepool-alpha-free
  //   opencode/iceman-free
  //   opencode/deepseek-v4.1-flash-free
  //   opencode/beam-free
  //   opencode/flint-40b-free
  //   opencode/hy4-flash-free
  //   opencode/mimo-v2.6-flash-free
  //   opencode/nemotron-3.5-lightning-free
  //   opencode/nemotron-3.5-super-vl-free
  // Use /models to pick one for the current session without editing this file.

  // Explicitly configure all free OpenCode Console models, plus local CPU models.
  "providers": {
    "opencode": {
      "models": {
        "big-pickle": {},
        "tidepool-alpha-free": {},
        "iceman-free": {},
        "deepseek-v4.1-flash-free": {},
        "beam-free": {},
        "flint-40b-free": {},
        "hy4-flash-free": {},
        "mimo-v2.6-flash-free": {},
        "nemotron-3.5-lightning-free": {},
        "nemotron-3.5-super-vl-free": {},
      },
    },

    // Local OpenAI-compatible server. OpenCode V2 uses "limit" (singular).
    // Runtime llama.cpp options are sent to the API through body.options.
    "local-phi4": {
      "name": "Local Phi-4 Mini",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1/models/phi4-mini",
        "headerTimeout": 600000,
        "chunkTimeout": 600000,
        "timeout": 1800000,
        "encoding": "none",
      },
      "compatibility": {
        "streamUsage": false,
      },
      "models": {
        "chat": {
          "name": "Phi-4 Mini CPU",
          "modelID": "phi4-mini",
          "limit": {
            "context": 16384,
            "output": 512,
          },
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"],
          },
          "body": {
            "options": {
              "n_ctx": 16384,
              "n_batch": 512,
              "flash_attn": true,
              "n_threads": 8,
              "temperature": 0.1,
              "top_p": 0.2,
              "top_k": 20,
              "min_p": 0.08,
              "repeat_penalty": 1.1,
            },
          },
        },
      },
    },

    "local-qwen-coder": {
      "name": "Local Qwen Coder",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1/models/qwen25-coder-3b",
        "headerTimeout": 600000,
        "chunkTimeout": 600000,
        "timeout": 1800000,
        "encoding": "none",
      },
      "compatibility": {
        "streamUsage": false,
      },
      "models": {
        "chat": {
          "name": "Qwen 2.5 Coder 3B CPU",
          "modelID": "qwen25-coder-3b",
          "limit": {
            "context": 16384,
            "output": 512,
          },
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"],
          },
          "body": {
            "options": {
              "n_ctx": 16384,
              "n_batch": 512,
              "flash_attn": true,
              "n_threads": 8,
              "temperature": 0.1,
              "top_p": 0.2,
              "top_k": 20,
              "min_p": 0.08,
              "repeat_penalty": 1.1,
            },
          },
        },
      },
    },

    "local-qwen-coder-05b": {
      "name": "Local Qwen Coder 0.5B",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1/models/qwen25-coder-05b",
        "headerTimeout": 600000,
        "chunkTimeout": 600000,
        "timeout": 1800000,
        "encoding": "none",
      },
      "compatibility": {
        "streamUsage": false,
      },
      "models": {
        "chat": {
          "name": "Qwen 2.5 Coder 0.5B CPU",
          "modelID": "qwen25-coder-05b",
          "limit": {
            "context": 16384,
            "output": 512,
          },
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"],
          },
          "body": {
            "options": {
              "n_ctx": 16384,
              "n_batch": 512,
              "flash_attn": true,
              "n_threads": 8,
              "temperature": 0.1,
              "top_p": 0.2,
              "top_k": 20,
              "min_p": 0.08,
              "repeat_penalty": 1.1,
            },
          },
        },
      },
    },
  },
}
